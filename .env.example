# Copy this file to `.env` and fill in the values.
# These are server-side keys consumed by /api/* serverless functions.
# Do NOT prefix with VITE_ — that would expose them in the client bundle.

# AudD song recognition — free tier (100 req/day)
# Get a token at https://audd.io
AUDD_API_KEY=

# Spotify Web API — Client Credentials flow (no user login required)
# Register an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
