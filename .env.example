# Copy this file to `.env` and fill in the value.
# This is a server-side key consumed by /api/audd.js — it is NOT exposed to
# the browser. Do NOT prefix with VITE_ (that would inline it in the bundle).

# AudD song recognition — free tier (100 req/day)
# Get a token at https://audd.io
AUDD_API_KEY=

# ReccoBeats (audio features + recommendations) needs NO key — the API is
# keyless and free. It's proxied by /api/reccobeats.js purely for caching
# and CORS. Nothing to configure here.
#   https://reccobeats.com
